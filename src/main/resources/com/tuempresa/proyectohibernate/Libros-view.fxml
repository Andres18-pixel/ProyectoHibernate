<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="444.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.proyectohibernate.Controller.LibroController">
    <children>
        <Label layoutX="28.0" layoutY="14.0" text="Registro de libros" />
        <GridPane layoutX="28.0" layoutY="42.0" prefHeight="122.0" prefWidth="278.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="94.39996337890625" minWidth="10.0" prefWidth="54.39996337890625" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="148.79998779296875" minWidth="10.0" prefWidth="145.60003662109375" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <TextField fx:id="txtTitulo" GridPane.columnIndex="1" />
                <TextField fx:id="txtAutor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="txtAnio" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Precio:" GridPane.rowIndex="3" />
                <Label text="Año:" GridPane.rowIndex="2" />
                <Label text="Autor:" GridPane.rowIndex="1" />
                <Label text="Titulo:" />
            </children>
        </GridPane>

        <Button fx:id="btnGuardar" layoutX="28.0" layoutY="175.0" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar libro" />
        <Button fx:id="btnModificar" layoutX="120.0" layoutY="175.0" mnemonicParsing="false" onAction="#modificarLibro" text="Modificar libro" />
        <Button fx:id="btnEliminar" layoutX="220.0" layoutY="175.0" mnemonicParsing="false" onAction="#eliminarLibro" text="Eliminar libro" />
        <Button fx:id="btnCargar" layoutX="314.0" layoutY="175.0" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar libros" />
        <Button fx:id="btnLimpiar" layoutX="410.0" layoutY="175.0" mnemonicParsing="false" text="Limpiar campos" />

        <TableView fx:id="tblLibros" layoutX="22.0" layoutY="222.0" prefHeight="200.0" prefWidth="566.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="119.20001220703125" text="Titulo" />
                <TableColumn fx:id="colAutor" prefWidth="188.79998779296875" text="Autor" />
                <TableColumn fx:id="colAnio" prefWidth="87.20001220703125" text="Año" />
                <TableColumn fx:id="colPrecio" prefWidth="95.2000732421875" text="Precio" />
            </columns>
        </TableView>
    </children>
</AnchorPane>